! =========================

vlan 10
 name Sales
exit

vlan 20
 name IT
exit

vlan 30
 name Admin
exit

vlan 99
 name Management
exit

vlan 90
 name Servers
exit


! =========================
! SVIs / DEFAULT GATEWAYS
! =========================

interface vlan 10
 ip address 10.10.0.2 255.255.255.0
 ip helper-address 10.255.255.5
exit

interface vlan 20
 ip address 10.20.0.2 255.255.255.0
 ip helper-address 10.255.255.5
exit

interface vlan 30
 ip address 10.30.0.2 255.255.255.0
 ip helper-address 10.255.255.5
