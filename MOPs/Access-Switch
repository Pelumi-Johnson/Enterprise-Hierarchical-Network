! =========================================================
! ACCESS SWITCH CONFIGURATIONS
! Enterprise Hierarchical Network
! =========================================================


! =========================
! ACC-SW1 — SALES
! =========================

enable
configure terminal
hostname ACC-SW1
lldp run
enable password class

line console 0
 password cisco
 login
exit

line vty 0 4
 password cisco
 login
exit

service password-encryption
spanning-tree mode rapid-pvst

vlan 10
 name Sales
exit
vlan 20
 name IT
exit
vlan 30
 name Admin
exit
vlan 99
 name Management
exit
vlan 90
 name Servers
exit

interface range fa0/1-2
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
exit

interface range fa0/6-7
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,90,99
exit


