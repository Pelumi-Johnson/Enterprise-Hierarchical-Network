! =========================================================
! ACCESS SWITCH CONFIGURATIONS
! Enterprise Hierarchical Network
! =========================================================


! =========================
! ACC-SW1 — SALES
! =========================

hostname ACC-SW1
spanning-tree mode rapid-pvst

vlan 10
 name Sales
vlan 20
 name IT
vlan 30
 name Admin
vlan 90
 name Servers
vlan 99
 name Management

interface range fa0/1-2
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast

interface range fa0/6-7
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,90,99


